PORT=3000
# Frontend chạy ở Vite dev server (cổng 5173). Cho phép nhiều origin bằng cách
# ngăn cách dấu phẩy, ví dụ: CORS_ORIGIN=http://localhost:5173,http://localhost:3000
CORS_ORIGIN=http://localhost:5173
FRONTEND_URL=http://localhost:5173
# Nếu không cấu hình `MONGO_URI`/`MONGODB_URI`, backend sẽ tự dùng Mongo local
# lưu dưới `.local-data/mongodb` để submissions vẫn giữ qua restart.
MONGO_URI=mongodb+srv://<username>:<password>@code-for-glory.m5fjjms.mongodb.net/test
JWT_SECRET=web_nhom_bi_mat_2026
